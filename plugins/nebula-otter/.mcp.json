{
  "mcpServers": {
    "nebula-otter": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/svnstfns/nebula-otter.git",
        "nebula-otter"
      ],
      "env": {
        "TRUENAS_HOST": "${TRUENAS_HOST}",
        "TRUENAS_API_KEY": "${TRUENAS_API_KEY}",
        "TRUENAS_USERNAME": "${TRUENAS_USERNAME:-pvnk}",
        "TRUENAS_SSL_VERIFY": "${TRUENAS_SSL_VERIFY:-true}",
        "MOCK_TRUENAS": "${MOCK_TRUENAS:-}"
      }
    }
  }
}
